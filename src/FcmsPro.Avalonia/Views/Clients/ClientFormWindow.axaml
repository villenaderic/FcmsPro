<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FcmsPro.Avalonia.ViewModels.Clients"
        x:Class="FcmsPro.Avalonia.Views.Clients.ClientFormWindow"
        x:DataType="vm:ClientFormViewModel"
        Title="{Binding HeaderText}"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="24" Spacing="10">
    <TextBlock Text="{Binding HeaderText}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />

    <TextBlock Text="Name *" FontWeight="SemiBold" />
    <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="Client or organization name" />

    <TextBlock Text="Client Type" FontWeight="SemiBold" />
    <ComboBox ItemsSource="{Binding ClientTypes}" SelectedItem="{Binding ClientType, Mode=TwoWay}"
              HorizontalAlignment="Stretch" />

    <TextBlock Text="Phone" FontWeight="SemiBold" />
    <TextBox Text="{Binding Phone, Mode=TwoWay}" Watermark="Optional" />

    <TextBlock Text="Email" FontWeight="SemiBold" />
    <TextBox Text="{Binding Email, Mode=TwoWay}" Watermark="Optional" />

    <TextBlock Text="Social" FontWeight="SemiBold" />
    <TextBox Text="{Binding Social, Mode=TwoWay}" Watermark="Optional handle or link" />

    <TextBlock Text="Notes" FontWeight="SemiBold" />
    <TextBox Text="{Binding Notes, Mode=TwoWay}" Watermark="Optional" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AppDestructiveBrush}" TextWrapping="Wrap"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
