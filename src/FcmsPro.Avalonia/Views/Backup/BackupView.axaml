<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FcmsPro.Avalonia.ViewModels.Backup"
             x:Class="FcmsPro.Avalonia.Views.Backup.BackupView"
             x:DataType="vm:BackupViewModel">

  <StackPanel Margin="24" Spacing="20" MaxWidth="480">
    <TextBlock Text="Backup" FontSize="28" FontWeight="Bold" />

    <TextBlock Text="{Binding LastBackupAt, StringFormat='Last backup: {0:g}'}"
               IsVisible="{Binding LastBackupAt, Converter={x:Static ObjectConverters.IsNotNull}}"
               Opacity="0.6" FontSize="12" />
    <TextBlock Text="No backup has been made yet."
               IsVisible="{Binding LastBackupAt, Converter={x:Static ObjectConverters.IsNull}}"
               Opacity="0.6" FontSize="12" />

    <StackPanel Spacing="8">
      <TextBlock Text="Export" FontWeight="Bold" FontSize="16" />
      <TextBlock Text="Save all your data (clients, commissions, payments, invoices, and more) to a single file."
                 Opacity="0.7" TextWrapping="Wrap" />
      <Button Content="Export Backup" Command="{Binding ExportCommand}" IsEnabled="{Binding !IsBusy}"
              Classes="accent" HorizontalAlignment="Left" />
    </StackPanel>

    <StackPanel Spacing="8">
      <TextBlock Text="Import" FontWeight="Bold" FontSize="16" />
      <TextBlock Text="Restore from a backup file, including one exported from the web/PWA version of this app."
                 Opacity="0.7" TextWrapping="Wrap" />
      <CheckBox Content="Replace all data instead of merging" IsChecked="{Binding ImportAsReplace, Mode=TwoWay}" />
      <Button Content="Import Backup..." Command="{Binding ImportCommand}" IsEnabled="{Binding !IsBusy}"
              HorizontalAlignment="Left" />
      <TextBlock Text="Note: your admin password is never included in a backup, for either export or import. If you import a backup from the web version, you'll keep using your current desktop password."
                 Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Spacing="8">
      <TextBlock Text="Automatic Backup" FontWeight="Bold" FontSize="16" />
      <TextBlock Text="Silently saves a copy of your data every time you close the app, kept separately from the backups you export above. This lives on the same computer, so it protects against accidental deletion or a bad import - not against losing the machine itself. Still export a copy somewhere else (external drive, cloud folder) every so often for real disaster recovery."
                 Opacity="0.7" TextWrapping="Wrap" />
      <CheckBox Content="Automatically back up on close" IsChecked="{Binding AutoBackupOnCloseEnabled, Mode=TwoWay}" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding AutoBackupOnCloseEnabled}">
        <TextBlock Text="Keep the last" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding AutoBackupKeepCount, Mode=TwoWay}" Minimum="1" Maximum="60" Width="110" />
        <TextBlock Text="backups" VerticalAlignment="Center" />
      </StackPanel>
      <Button Content="Save" Command="{Binding SaveAutoBackupSettingsCommand}" HorizontalAlignment="Left" />
    </StackPanel>

    <TextBlock Text="{Binding StatusMessage}" Opacity="0.8" TextWrapping="Wrap"
               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
