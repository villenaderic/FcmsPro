<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FcmsPro.Avalonia.ViewModels.Payments"
        xmlns:entities="using:FcmsPro.Core.Entities"
        x:Class="FcmsPro.Avalonia.Views.Payments.PaymentFormWindow"
        x:DataType="vm:PaymentFormViewModel"
        Title="Record Payment"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="24" Spacing="10">
    <TextBlock Text="Record Payment" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />

    <TextBlock Text="Commission *" FontWeight="SemiBold" />
    <ComboBox ItemsSource="{Binding AvailableCommissions}" SelectedItem="{Binding SelectedCommission, Mode=TwoWay}"
              HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="entities:Commission">
          <TextBlock Text="{Binding Title}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="{Binding SelectedCommissionRemaining, StringFormat='Balance due: {0:C2}'}"
               FontSize="12" Opacity="0.7"
               IsVisible="{Binding SelectedCommission, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <TextBlock Text="Amount *" FontWeight="SemiBold" />
    <NumericUpDown Value="{Binding Amount, Mode=TwoWay}" Minimum="0" FormatString="C2" />

    <TextBlock Text="Payment Method" FontWeight="SemiBold" />
    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding Method, Mode=TwoWay}" HorizontalAlignment="Stretch" />

    <TextBlock Text="Date" FontWeight="SemiBold" />
    <CalendarDatePicker SelectedDate="{Binding Date, Mode=TwoWay}" HorizontalAlignment="Stretch" />

    <TextBlock Text="Reference Number" FontWeight="SemiBold" />
    <TextBox Text="{Binding ReferenceNumber, Mode=TwoWay}" Watermark="Optional" />

    <TextBlock Text="Notes" FontWeight="SemiBold" />
    <TextBox Text="{Binding Notes, Mode=TwoWay}" Watermark="Optional" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AppDestructiveBrush}" TextWrapping="Wrap"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Content="Record Payment" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
