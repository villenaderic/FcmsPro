<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FcmsPro.Avalonia.ViewModels.Payments"
             xmlns:conv="using:FcmsPro.Avalonia.Converters"
             x:Class="FcmsPro.Avalonia.Views.Payments.PaymentsListView"
             x:DataType="vm:PaymentsListViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="24">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0">
        <TextBlock Text="Income" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="{Binding FilteredByClient.Name, StringFormat='Filtered by client: {0}'}"
                   IsVisible="{Binding FilteredByClient, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Opacity="0.6" FontSize="12" />
      </StackPanel>
      <Button Grid.Column="1" Content="+ Record Income" Command="{Binding AddCommand}" Classes="accent" />
    </Grid>

    <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource AppDestructiveBrush}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Margin="0,0,0,12" TextWrapping="Wrap" />

    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
      <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
               Watermark="Search by reference number or commission..." Width="300"
               Margin="0,0,12,8" />
      <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortOption, Mode=TwoWay}" Width="170" Margin="0,0,0,8">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static conv:ListSortOptionLabelConverter.Instance}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </WrapPanel>

    <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="2" Margin="0,0,0,8" IsVisible="{Binding IsLoading}" />

    <StackPanel Grid.Row="4" Grid.RowSpan="2" IsVisible="{Binding HasNoResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="320">
      <Image Source="avares://FcmsPro/Assets/illustration-empty-state.png" Width="160" Opacity="0.85" />
      <TextBlock Text="No payments yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="Payments recorded against a commission will show up here."
                 TextWrapping="Wrap" TextAlignment="Center" Opacity="0.6" />
      <Button Content="+ Record Payment" Command="{Binding AddCommand}" Classes="accent" HorizontalAlignment="Center" Margin="0,4,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="4" Grid.RowSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding !HasNoResults}">
      <Grid MinWidth="850">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnDefinitions="*,*,100,110,100,90" Margin="12,0,12,4">
          <TextBlock Grid.Column="0" Text="Commission" Classes="tableHeader" />
          <TextBlock Grid.Column="1" Text="Client" Classes="tableHeader" />
          <TextBlock Grid.Column="2" Text="Amount" Classes="tableHeader" Margin="8,0" />
          <TextBlock Grid.Column="3" Text="Method" Classes="tableHeader" Margin="8,0" />
          <TextBlock Grid.Column="4" Text="Date" Classes="tableHeader" Margin="8,0" />
          <TextBlock Grid.Column="5" Text="Actions" Classes="tableHeader" />
        </Grid>

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PaymentRowViewModel">
                  <Border Classes="listRow" Background="Transparent" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,0,1" Padding="12,10">
                    <Grid ColumnDefinitions="*,*,100,110,100,90">
                      <TextBlock Grid.Column="0" Text="{Binding CommissionTitle}" FontWeight="SemiBold"
                                 Margin="0,0,8,0" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding ClientName}" Opacity="0.8"
                                 Margin="0,0,8,0" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding Payment.Amount, StringFormat='{}{0:C2}'}" Margin="8,0" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3" Text="{Binding Payment.Method}" Margin="8,0" Opacity="0.7" />
                      <TextBlock Grid.Column="4" Text="{Binding Payment.Date}" Margin="8,0" Opacity="0.7" />
                      <Button Grid.Column="5" Content="Refund"
                              Command="{Binding $parent[ItemsControl].((vm:PaymentsListViewModel)DataContext).RefundCommand}"
                              CommandParameter="{Binding}" Classes="destructive" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
      </Grid>
    </ScrollViewer>

  </Grid>
</UserControl>
