<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FcmsPro.Avalonia.ViewModels.Expenses"
        x:Class="FcmsPro.Avalonia.Views.Expenses.ExpenseFormWindow"
        x:DataType="vm:ExpenseFormViewModel"
        Title="{Binding HeaderText}"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="24" Spacing="10">
    <TextBlock Text="{Binding HeaderText}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />

    <TextBlock Text="Description *" FontWeight="SemiBold" />
    <TextBox Text="{Binding Description, Mode=TwoWay}" />

    <TextBlock Text="Category" FontWeight="SemiBold" />
    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" HorizontalAlignment="Stretch" />

    <TextBlock Text="Amount *" FontWeight="SemiBold" />
    <NumericUpDown Value="{Binding Amount, Mode=TwoWay}" Minimum="0" FormatString="C2" />

    <TextBlock Text="Date" FontWeight="SemiBold" />
    <CalendarDatePicker SelectedDate="{Binding Date, Mode=TwoWay}" HorizontalAlignment="Stretch" />

    <TextBlock Text="Repeats" FontWeight="SemiBold" />
    <ComboBox ItemsSource="{Binding RecurFrequencies}" SelectedItem="{Binding RecurFrequency, Mode=TwoWay}"
              HorizontalAlignment="Stretch" />
    <TextBlock Text="If set, a new copy of this expense is created automatically each period."
               FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

    <TextBlock Text="Notes" FontWeight="SemiBold" />
    <TextBox Text="{Binding Notes, Mode=TwoWay}" Watermark="Optional" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AppDestructiveBrush}" TextWrapping="Wrap"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
