<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FcmsPro.Avalonia.ViewModels.Templates"
        x:Class="FcmsPro.Avalonia.Views.Templates.TemplateFormWindow"
        x:DataType="vm:TemplateFormViewModel"
        Title="{Binding HeaderText}"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="24" Spacing="10">
    <TextBlock Text="{Binding HeaderText}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />

    <TextBlock Text="Name *" FontWeight="SemiBold" />
    <TextBox Text="{Binding Name, Mode=TwoWay}" />

    <TextBlock Text="Service Type" FontWeight="SemiBold" />
    <TextBox Text="{Binding ServiceType, Mode=TwoWay}" />

    <Grid ColumnDefinitions="*,*">
      <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
        <TextBlock Text="Price" FontWeight="SemiBold" />
        <NumericUpDown Value="{Binding Price, Mode=TwoWay}" Minimum="0" FormatString="C2" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="Down Payment" FontWeight="SemiBold" />
        <NumericUpDown Value="{Binding DownPayment, Mode=TwoWay}" Minimum="0" FormatString="C2" />
      </StackPanel>
    </Grid>

    <TextBlock Text="Deadline (days from today when used)" FontWeight="SemiBold" />
    <NumericUpDown Value="{Binding DeadlineDays, Mode=TwoWay}" Minimum="0" />

    <TextBlock Text="Description" FontWeight="SemiBold" />
    <TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AppDestructiveBrush}" TextWrapping="Wrap"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
