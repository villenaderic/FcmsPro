<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FcmsPro.Avalonia.Views.Icons.TemplatesIcon"
             Width="16" Height="16">
  <!-- Two overlapping pages - a stack of reusable documents. The front
       page's Fill uses the sidebar's own background color (not
       Transparent) specifically so its outline reads as sitting ON TOP of
       the back page rather than the two outlines just crossing each other. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="24" Height="24">
      <Rectangle Canvas.Left="4" Canvas.Top="6" Width="13" Height="16" RadiusX="1" RadiusY="1"
                 Stroke="{DynamicResource AppTextSecondaryBrush}" StrokeThickness="2" />
      <Rectangle Canvas.Left="7" Canvas.Top="2" Width="13" Height="16" RadiusX="1" RadiusY="1"
                 Fill="{DynamicResource SystemAltHighColor}"
                 Stroke="{DynamicResource AppTextSecondaryBrush}" StrokeThickness="2" />
    </Canvas>
  </Viewbox>
</UserControl>
