<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FcmsPro.Avalonia.Views.Icons.InvoicesIcon"
             Width="16" Height="16">
  <!-- Document + checkmark - "billed and confirmed", distinct from the
       draft-pen look of QuotesIcon. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="24" Height="24">
      <Rectangle Canvas.Left="5" Canvas.Top="2" Width="14" Height="18" RadiusX="1" RadiusY="1"
                 Stroke="{DynamicResource AppTextSecondaryBrush}" StrokeThickness="2" />
      <Path Data="M 8,13 L 11,16 L 17,9"
            Stroke="{DynamicResource AppTextSecondaryBrush}" StrokeThickness="2"
            StrokeLineCap="Round" StrokeJoin="Round" />
    </Canvas>
  </Viewbox>
</UserControl>
