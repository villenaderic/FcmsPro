<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FcmsPro.Avalonia.Views.Icons.QuotesIcon"
             Width="16" Height="16">
  <!-- Document + a diagonal pen stroke - "drafting an estimate". Distinct
       from InvoicesIcon (checkmark) and ReceiptsIcon (ruled lines) so the
       three money-document pages don't look identical at a glance. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="24" Height="24">
      <Rectangle Canvas.Left="4" Canvas.Top="3" Width="12" Height="18" RadiusX="1" RadiusY="1"
                 Stroke="{DynamicResource AppTextSecondaryBrush}" StrokeThickness="2" />
      <Line StartPoint="14,15" EndPoint="21,8" Stroke="{DynamicResource AppTextSecondaryBrush}" StrokeThickness="2" StrokeLineCap="Round" />
      <Line StartPoint="19,6" EndPoint="21,8" Stroke="{DynamicResource AppTextSecondaryBrush}" StrokeThickness="2" StrokeLineCap="Round" />
    </Canvas>
  </Viewbox>
</UserControl>
