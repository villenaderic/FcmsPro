<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FcmsPro.Avalonia.Views.Icons.PaymentsIcon"
             Width="16" Height="16">
  <!-- Payment card with a magnetic-stripe bar. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="24" Height="24">
      <Rectangle Canvas.Left="2" Canvas.Top="6" Width="20" Height="13" RadiusX="2" RadiusY="2"
                 Stroke="{DynamicResource AppTextSecondaryBrush}" StrokeThickness="2" />
      <Rectangle Canvas.Left="2" Canvas.Top="9" Width="20" Height="3"
                 Fill="{DynamicResource AppTextSecondaryBrush}" />
    </Canvas>
  </Viewbox>
</UserControl>
