<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FcmsPro.Avalonia.ViewModels.Settings"
             x:Class="FcmsPro.Avalonia.Views.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="24" MaxWidth="520">
      <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" />

      <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" FontSize="12"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Business info -->
      <StackPanel Spacing="8">
        <TextBlock Text="Business Info" FontWeight="Bold" FontSize="16" />
        <TextBlock Text="Business Name" FontWeight="SemiBold" />
        <TextBox Text="{Binding BusinessName, Mode=TwoWay}" />
        <TextBlock Text="Freelancer Name" FontWeight="SemiBold" />
        <TextBox Text="{Binding FreelancerName, Mode=TwoWay}" />
        <TextBlock Text="Address" FontWeight="SemiBold" />
        <TextBox Text="{Binding Address, Mode=TwoWay}" />
        <TextBlock Text="Contact Number" FontWeight="SemiBold" />
        <TextBox Text="{Binding ContactNumber, Mode=TwoWay}" />
        <TextBlock Text="Email" FontWeight="SemiBold" />
        <TextBox Text="{Binding Email, Mode=TwoWay}" />
        <TextBlock Text="Website" FontWeight="SemiBold" />
        <TextBox Text="{Binding Website, Mode=TwoWay}" />
        <TextBlock Text="TIN" FontWeight="SemiBold" />
        <TextBox Text="{Binding Tin, Mode=TwoWay}" />
        <TextBlock Text="Currency Symbol" FontWeight="SemiBold" />
        <TextBox Text="{Binding CurrencySymbol, Mode=TwoWay}" Width="80" HorizontalAlignment="Left" />
        <TextBlock Text="Service Types (comma-separated)" FontWeight="SemiBold" />
        <TextBox Text="{Binding ServiceTypesCsv, Mode=TwoWay}" Watermark="Illustration, Logo, Character Design, ..." />
      </StackPanel>

      <!-- Document defaults -->
      <StackPanel Spacing="8">
        <TextBlock Text="Document Defaults" FontWeight="Bold" FontSize="16" />
        <TextBlock Text="Receipt Footer" FontWeight="SemiBold" />
        <TextBox Text="{Binding ReceiptFooter, Mode=TwoWay}" AcceptsReturn="True" Height="40" TextWrapping="Wrap" />
        <TextBlock Text="Invoice Terms" FontWeight="SemiBold" />
        <TextBox Text="{Binding InvoiceTerms, Mode=TwoWay}" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />
        <TextBlock Text="Invoice Notes" FontWeight="SemiBold" />
        <TextBox Text="{Binding InvoiceNotes, Mode=TwoWay}" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />
        <TextBlock Text="Quote Terms" FontWeight="SemiBold" />
        <TextBox Text="{Binding QuoteTerms, Mode=TwoWay}" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />

        <TextBlock Text="Automation" FontWeight="Bold" FontSize="16" Margin="0,12,0,0" />
        <CheckBox Content="Automatically generate an invoice when a commission is marked Delivered"
                  IsChecked="{Binding AutoInvoiceOnDelivery, Mode=TwoWay}" />
        <TextBlock Text="Only fires if the commission still has an outstanding balance, and only once per commission - the generated invoice starts as a Draft you can review before sending."
                   Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding AutoInvoiceOnDelivery}">
          <TextBlock Text="Due" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding InvoiceDueDays, Mode=TwoWay}" Minimum="0" Maximum="365" Width="120" />
          <TextBlock Text="days after issue" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <Button Content="Save Business Settings" Command="{Binding SaveBusinessInfoCommand}"
              IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left" />

      <!-- Appearance -->
      <StackPanel Spacing="8">
        <TextBlock Text="Appearance" FontWeight="Bold" FontSize="16" />
        <TextBlock Text="Theme" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme, Mode=TwoWay}" Width="160" HorizontalAlignment="Left" />
        <TextBlock Text="Accent Color (hex)" FontWeight="SemiBold" />
        <TextBox Text="{Binding AccentColor, Mode=TwoWay}" Width="120" HorizontalAlignment="Left" />
        <Button Content="Save Appearance" Command="{Binding SaveAppearanceCommand}" HorizontalAlignment="Left" />
      </StackPanel>

      <!-- Account -->
      <StackPanel Spacing="8">
        <TextBlock Text="Account" FontWeight="Bold" FontSize="16" />
        <TextBlock Text="New Password" FontWeight="SemiBold" />
        <TextBox Text="{Binding NewPassword, Mode=TwoWay}" PasswordChar="*" />
        <TextBlock Text="Confirm Password" FontWeight="SemiBold" />
        <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}" PasswordChar="*" />
        <TextBlock Text="{Binding PasswordErrorMessage}" Foreground="{DynamicResource AppDestructiveBrush}"
                   IsVisible="{Binding PasswordErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Content="Change Password" Command="{Binding ChangePasswordCommand}"
                IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" />
      </StackPanel>

      <!-- Advanced -->
      <StackPanel Spacing="8">
        <TextBlock Text="Advanced" FontWeight="Bold" FontSize="16" />
        <Button Content="View Activity Log" Command="{Binding ViewLogsCommand}" HorizontalAlignment="Left" />
        <Button Content="View Trash" Command="{Binding ViewTrashCommand}" HorizontalAlignment="Left" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
