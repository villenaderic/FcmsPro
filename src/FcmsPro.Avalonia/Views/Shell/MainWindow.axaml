<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FcmsPro.Avalonia.ViewModels.Shell"
        xmlns:conv="using:FcmsPro.Avalonia.Converters"
        xmlns:clientsVm="using:FcmsPro.Avalonia.ViewModels.Clients"
        xmlns:clientsViews="using:FcmsPro.Avalonia.Views.Clients"
        xmlns:icons="using:FcmsPro.Avalonia.Views.Icons"
        xmlns:commissionsVm="using:FcmsPro.Avalonia.ViewModels.Commissions"
        xmlns:commissionsViews="using:FcmsPro.Avalonia.Views.Commissions"
        xmlns:paymentsVm="using:FcmsPro.Avalonia.ViewModels.Payments"
        xmlns:paymentsViews="using:FcmsPro.Avalonia.Views.Payments"

        xmlns:expensesVm="using:FcmsPro.Avalonia.ViewModels.Expenses"
        xmlns:expensesViews="using:FcmsPro.Avalonia.Views.Expenses"
        xmlns:goalsVm="using:FcmsPro.Avalonia.ViewModels.Goals"
        xmlns:goalsViews="using:FcmsPro.Avalonia.Views.Goals"
        xmlns:dashboardVm="using:FcmsPro.Avalonia.ViewModels.Dashboard"
        xmlns:dashboardViews="using:FcmsPro.Avalonia.Views.Dashboard"
        xmlns:analyticsVm="using:FcmsPro.Avalonia.ViewModels.Analytics"
        xmlns:analyticsViews="using:FcmsPro.Avalonia.Views.Analytics"
        xmlns:settingsVm="using:FcmsPro.Avalonia.ViewModels.Settings"
        xmlns:settingsViews="using:FcmsPro.Avalonia.Views.Settings"

        xmlns:logsVm="using:FcmsPro.Avalonia.ViewModels.Logs"
        xmlns:logsViews="using:FcmsPro.Avalonia.Views.Logs"
        xmlns:trashVm="using:FcmsPro.Avalonia.ViewModels.Trash"
        xmlns:trashViews="using:FcmsPro.Avalonia.Views.Trash"
        xmlns:backupVm="using:FcmsPro.Avalonia.ViewModels.Backup"
        xmlns:backupViews="using:FcmsPro.Avalonia.Views.Backup"
        xmlns:svc="using:FcmsPro.Avalonia.Services"
        x:Class="FcmsPro.Avalonia.Views.Shell.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FCMS Pro"
        Width="1280" Height="720"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="Auto,Auto,*">

    <!-- Slim rail shown only when the sidebar is collapsed - the sole
         purpose is to keep a way back in, since the full sidebar (which
         normally hosts the toggle button) is hidden entirely in that
         state. Background fills edge-to-edge with no top margin, matching
         the expanded sidebar below - it previously had Margin="0,20,0,0" on
         this same Border, which left a visible gap of the window's plain
         background above the rail that the expanded sidebar doesn't have,
         looking like the rail wasn't fully rendered. The 20px of top
         breathing room the buttons need is now on the inner StackPanel
         instead, where it doesn't affect the colored background's extent. -->
    <Border Grid.Column="0" Width="36" Background="{DynamicResource SystemAltHighColor}"
            IsVisible="{Binding IsSidebarCollapsed}">
      <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">
        <Button Content="&#9776;" FontSize="14" Padding="6,4"
                Background="Transparent" BorderThickness="0"
                ToolTip.Tip="Expand sidebar (Ctrl+B)"
                Command="{Binding ToggleSidebarCommand}" />
        <Button Padding="6,4" Margin="0,4,0,0"
                Background="Transparent" BorderThickness="0"
                ToolTip.Tip="Search everything (/)"
                Command="{Binding OpenGlobalSearchCommand}">
          <icons:SearchIcon Width="14" Height="14" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Sidebar -->
    <StackPanel Grid.Column="1" Width="212" Background="{DynamicResource SystemAltHighColor}"
                IsVisible="{Binding !IsSidebarCollapsed}" Spacing="2" Margin="0">

      <Grid ColumnDefinitions="*,Auto" Margin="16,20,12,20">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <Image Source="avares://FcmsPro/Assets/app-icon-64.png" Width="26" Height="26" />
          <TextBlock Text="FCMS Pro" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Content="&#9776;" FontSize="14" Padding="6,2"
                Background="Transparent" BorderThickness="0"
                ToolTip.Tip="Collapse sidebar (Ctrl+B)"
                Command="{Binding ToggleSidebarCommand}" />
      </Grid>

      <StackPanel Margin="8,0" Spacing="2">
        <Button Classes="navitem" HorizontalContentAlignment="Left" Command="{Binding OpenGlobalSearchCommand}"
                ToolTip.Tip="Search everything (/)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:SearchIcon Width="13" Height="13" VerticalAlignment="Center" />
            <TextBlock Text="Search..." Opacity="0.7" />
          </StackPanel>
        </Button>
        <Border Height="1" Background="{DynamicResource SystemBaseLowColor}" Margin="4,6" />

        <!--
          Content changed from a plain string to inline icon+label
          StackPanels (matching the Search button above) - the icon itself
          doesn't recolor on the active state (Classes.active only affects
          Foreground/Background via App.axaml's Button.navitem.active style,
          which doesn't reach into a child UserControl's own Stroke/Fill
          bindings), so the bold white label + tinted background pill still
          carry the "this is where you are" signal, same as before; the icon
          adds a scan-by-shape cue next to it.
        -->
        <Button Classes="navitem" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static svc:AppPage.Dashboard}"
                Classes.active="{Binding Navigation.CurrentPage, Converter={x:Static conv:PageMatchConverter.Instance}, ConverterParameter={x:Static svc:AppPage.Dashboard}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:DashboardIcon Width="14" Height="14" />
            <TextBlock Text="Dashboard" />
          </StackPanel>
        </Button>
        <Button Classes="navitem" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static svc:AppPage.Analytics}"
                Classes.active="{Binding Navigation.CurrentPage, Converter={x:Static conv:PageMatchConverter.Instance}, ConverterParameter={x:Static svc:AppPage.Analytics}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:AnalyticsIcon Width="14" Height="14" />
            <TextBlock Text="Analytics" />
          </StackPanel>
        </Button>
        <Button Classes="navitem" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static svc:AppPage.Clients}"
                Classes.active="{Binding Navigation.CurrentPage, Converter={x:Static conv:PageMatchConverter.Instance}, ConverterParameter={x:Static svc:AppPage.Clients}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:ClientsIcon Width="14" Height="14" />
            <TextBlock Text="Clients" />
          </StackPanel>
        </Button>
        <Button Classes="navitem" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static svc:AppPage.Commissions}"
                Classes.active="{Binding Navigation.CurrentPage, Converter={x:Static conv:PageMatchConverter.Instance}, ConverterParameter={x:Static svc:AppPage.Commissions}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:CommissionsIcon Width="14" Height="14" />
            <TextBlock Text="Commissions" />
          </StackPanel>
        </Button>

        <Button Classes="navitem" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static svc:AppPage.Payments}"
                Classes.active="{Binding Navigation.CurrentPage, Converter={x:Static conv:PageMatchConverter.Instance}, ConverterParameter={x:Static svc:AppPage.Payments}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:PaymentsIcon Width="14" Height="14" />
            <TextBlock Text="Income" />
          </StackPanel>
        </Button>

        <Button Classes="navitem" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static svc:AppPage.Expenses}"
                Classes.active="{Binding Navigation.CurrentPage, Converter={x:Static conv:PageMatchConverter.Instance}, ConverterParameter={x:Static svc:AppPage.Expenses}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:ExpensesIcon Width="14" Height="14" />
            <TextBlock Text="Expenses" />
          </StackPanel>
        </Button>
        <Button Classes="navitem" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static svc:AppPage.Goals}"
                Classes.active="{Binding Navigation.CurrentPage, Converter={x:Static conv:PageMatchConverter.Instance}, ConverterParameter={x:Static svc:AppPage.Goals}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:GoalsIcon Width="14" Height="14" />
            <TextBlock Text="Goals" />
          </StackPanel>
        </Button>


        <Button Classes="navitem" Command="{Binding ToggleThemeCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="&#9728;" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="14" />
            <TextBlock Text="Toggle Theme" />
          </StackPanel>
        </Button>

        <Border Height="1" Background="{DynamicResource SystemBaseLowColor}" Margin="4,10" />

        <Button Classes="navitem" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static svc:AppPage.Backup}"
                Classes.active="{Binding Navigation.CurrentPage, Converter={x:Static conv:PageMatchConverter.Instance}, ConverterParameter={x:Static svc:AppPage.Backup}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:BackupIcon Width="14" Height="14" />
            <TextBlock Text="Backup" />
          </StackPanel>
        </Button>
        <Button Classes="navitem" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static svc:AppPage.Settings}"
                Classes.active="{Binding Navigation.CurrentPage, Converter={x:Static conv:PageMatchConverter.Instance}, ConverterParameter={x:Static svc:AppPage.Settings}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:SettingsIcon Width="14" Height="14" />
            <TextBlock Text="Settings" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>

    <!-- Content area: DataTemplates map each page ViewModel to its View.
         PlaceholderPageViewModel covers any AppPage without a real module
         implementation yet. -->
    <!-- Vertical scroll only - horizontal scroll would give child content
         unconstrained width, which stops Grid "*" columns and other
         responsive sizing in module pages from actually shrinking to fit a
         narrow/split-screen window; better for those to reflow/wrap than to
         silently get an unbounded layout pass. -->
    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border Padding="24">
      <ContentControl Content="{Binding CurrentPageViewModel}">
        <ContentControl.DataTemplates>

          <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding PageName}" FontSize="28" FontWeight="Bold" />
              <TextBlock Text="This page's content lands in its module implementation phase."
                         Opacity="0.6" />
            </StackPanel>
          </DataTemplate>

          <DataTemplate DataType="{x:Type clientsVm:ClientsListViewModel}">
            <clientsViews:ClientsListView />
          </DataTemplate>

          <DataTemplate DataType="{x:Type clientsVm:ClientProfileViewModel}">
            <clientsViews:ClientProfileView />
          </DataTemplate>

          <DataTemplate DataType="{x:Type commissionsVm:CommissionsListViewModel}">
            <commissionsViews:CommissionsListView />
          </DataTemplate>

          <DataTemplate DataType="{x:Type commissionsVm:CommissionProfileViewModel}">
            <commissionsViews:CommissionProfileView />
          </DataTemplate>

          <DataTemplate DataType="{x:Type paymentsVm:PaymentsListViewModel}">
            <paymentsViews:PaymentsListView />
          </DataTemplate>



          <DataTemplate DataType="{x:Type expensesVm:ExpensesListViewModel}">
            <expensesViews:ExpensesListView />
          </DataTemplate>

          <DataTemplate DataType="{x:Type goalsVm:GoalsViewModel}">
            <goalsViews:GoalsView />
          </DataTemplate>

          <DataTemplate DataType="{x:Type dashboardVm:DashboardViewModel}">
            <dashboardViews:DashboardView />
          </DataTemplate>

          <DataTemplate DataType="{x:Type analyticsVm:AnalyticsViewModel}">
            <analyticsViews:AnalyticsView />
          </DataTemplate>

          <DataTemplate DataType="{x:Type settingsVm:SettingsViewModel}">
            <settingsViews:SettingsView />
          </DataTemplate>



          <DataTemplate DataType="{x:Type logsVm:LogsViewModel}">
            <logsViews:LogsView />
          </DataTemplate>

          <DataTemplate DataType="{x:Type trashVm:TrashViewModel}">
            <trashViews:TrashView />
          </DataTemplate>

          <DataTemplate DataType="{x:Type backupVm:BackupViewModel}">
            <backupViews:BackupView />
          </DataTemplate>

        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>
    </ScrollViewer>

  </Grid>
</Window>
