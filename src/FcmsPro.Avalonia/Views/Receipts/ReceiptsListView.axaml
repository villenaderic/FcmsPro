<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FcmsPro.Avalonia.ViewModels.Receipts"
             xmlns:entities="using:FcmsPro.Core.Entities"
             xmlns:conv="using:FcmsPro.Avalonia.Converters"
             x:Class="FcmsPro.Avalonia.Views.Receipts.ReceiptsListView"
             x:DataType="vm:ReceiptsListViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="24">

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Receipts" FontSize="28" FontWeight="Bold" />
      <TextBlock Text="{Binding FilteredByClient.Name, StringFormat='Filtered by client: {0}'}"
                 IsVisible="{Binding FilteredByClient, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Opacity="0.6" FontSize="12" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBox Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}"
               Watermark="Search by receipt #, client, or commission..." MaxWidth="320"
               HorizontalAlignment="Stretch" Margin="0,0,12,0" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortOption, Mode=TwoWay}" Width="170">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static conv:ListSortOptionLabelConverter.Instance}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Opacity="0.7" FontSize="12" Margin="0,0,0,8"
               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="2" Margin="0,0,0,8" IsVisible="{Binding IsLoading}" />

    <Grid Grid.Row="4" ColumnDefinitions="100,*,*,Auto,Auto" Margin="12,0,12,4">
      <TextBlock Grid.Column="0" Text="Receipt #" Classes="tableHeader" />
      <TextBlock Grid.Column="1" Text="Client" Classes="tableHeader" Margin="8,0" />
      <TextBlock Grid.Column="2" Text="Commission" Classes="tableHeader" Margin="8,0" />
      <TextBlock Grid.Column="3" Text="Amount" Classes="tableHeader" />
      <TextBlock Grid.Column="4" Text="Actions" Classes="tableHeader" Margin="12,0,0,0" />
    </Grid>

    <Grid Grid.Row="5">
      <StackPanel IsVisible="{Binding HasNoResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="320">
        <Image Source="avares://FcmsPro/Assets/illustration-empty-state.png" Width="160" Opacity="0.85" />
        <TextBlock Text="No receipts yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="Receipts are generated automatically when you record a payment - there's no manual create form here."
                   TextWrapping="Wrap" TextAlignment="Center" Opacity="0.6" />
      </StackPanel>

      <ScrollViewer IsVisible="{Binding !HasNoResults}">
        <ItemsControl ItemsSource="{Binding Receipts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="entities:Receipt">
              <Border Classes="listRow" Background="Transparent" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,0,1" Padding="12,10">
                <Grid ColumnDefinitions="100,*,*,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding ReceiptNumber}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding ClientName}" Margin="8,0" />
                  <TextBlock Grid.Column="2" Text="{Binding CommissionTitle}" Margin="8,0" Opacity="0.8"
                             TextWrapping="Wrap" />
                  <TextBlock Grid.Column="3" Text="{Binding AmountPaid, StringFormat='{}{0:C2}'}" Margin="8,0" FontWeight="SemiBold" />
                  <Button Grid.Column="4" Content="Download PDF"
                          Command="{Binding $parent[ItemsControl].((vm:ReceiptsListViewModel)DataContext).DownloadPdfCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

  </Grid>
</UserControl>
